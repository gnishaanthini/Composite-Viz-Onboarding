{
  "manifest_version": 3,
  "name": "VIS Onboarder 1",
  "version": "1.0",
  "description": "Injects onboarding tours into visualization dashboards.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Launch Onboarding"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}